# ==============================================================================
# REAL-TIME VOICE AI AGENT - ENVIRONMENT TEMPLATE
# Copy this file to .env.local and populate with your credentials.
# NEVER commit your actual .env.local file to version control.
# ==============================================================================

# AWS Bedrock Configuration (Optional for Bedrock streaming backend)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Voice Engine & TTS Provider (Cartesia, ElevenLabs, or Amazon Polly)
TTS_PROVIDER=polly
TTS_VOICE_ID=Ruth
ELEVENLABS_API_KEY=your_elevenlabs_api_key_optional

# Audio & Streaming Server Configuration
VOICE_SERVER_PORT=8765
VOICE_SERVER_HOST=127.0.0.1
NEXT_PUBLIC_VOICE_WS_URL=ws://127.0.0.1:8765

# Latency Budget Target (Milliseconds)
TARGET_LATENCY_MS=750
VAD_SILENCE_THRESHOLD_MS=120
